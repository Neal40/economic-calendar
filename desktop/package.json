{
  "name": "economic-calendar",
  "productName": "Inner Circle Trader",
  "version": "1.27.1",
  "description": "Inner Circle Trader",
  "author": "Neal_ICT",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js ../index.html",
    "dist": "npm run prepare-app && electron-builder --win portable --x64",
    "ict": "npm run prepare-app && electron-builder --win portable --x64 --config.compression=store && node -e \"require('fs').copyFileSync('dist/Inner Circle Trader.exe', require('path').join(require('os').homedir(), 'Desktop', 'Inner Circle Trader', 'Inner Circle Trader.exe')); console.log('-> Bureau/Inner Circle Trader/Inner Circle Trader.exe')\"",
    "dist:mac": "npm run prepare-app && electron-builder --mac dmg zip --universal"
  },
  "build": {
    "appId": "com.nealict.economiccalendar",
    "files": [
      "main.js",
      "preload.js",
      "topstepx.js",
      "notion.js",
      "marketdata.js",
      "copier.js",
      "backup.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Inner Circle Trader.exe"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Inner-Circle-Trader-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Inner-Circle-Trader-mac.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "d3": "^7.9.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
